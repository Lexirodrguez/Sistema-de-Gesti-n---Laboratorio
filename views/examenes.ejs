<!DOCTYPE html>
<html lang="es">

<head>
  <title>Gestion de Examenes</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>

  <div class="logout-container">
    <a href="/auth/logout" class="logout-btn">Cerrar Sesion</a>
  </div>

  <h1>Lista de Examenes</h1>

  <% var esBioanalista=usuario && usuario.rol==='bioanalista' ; %>
    <% var esSecretaria=usuario && usuario.rol==='secretaria' ; %>

      <nav>
        <ul>
          <li><a href="/">Inicio</a></li>
          <% if (esBioanalista || esSecretaria) { %>
            <li><a href="#agregar-examen">+ Agregar Examen</a></li>
            <% } %>
        </ul>
      </nav>

      <table>
        <thead>
          <tr>
            <th>ID</th>
            <th>Nombre</th>
            <th>Precio</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody>
          <% examenes.forEach(function(examen) { %>
            <tr>
              <td>
                <%= examen.id_examenes %>
              </td>
              <td>
                <%= examen.nombre_examenes %>
              </td>
              <td>
                <%= examen.precio_examenes %>$
              </td>
              <td>
                <div style="display:flex; gap:5px; align-items:center; flex-wrap:wrap;">

                  <% if (esBioanalista) { %>
                    <button type="button" onclick="abrirModal('<%= examen.id_examenes %>')">Formulario</button>
                    <a href="/examenes/<%= examen.id_examenes %>/editar">
                      <button type="button">Editar</button>
                    </a>
                    <form action="/examenes/<%= examen.id_examenes %>/eliminar" method="POST" style="display:inline;">
                      <button type="submit" onclick="return confirm('Eliminar examen?')">Eliminar</button>
                    </form>
                    <% } %>

                      <% if (esSecretaria) { %>
                        <a href="/examenes/<%= examen.id_examenes %>/editar">
                          <button type="button">Editar</button>
                        </a>
                        <form action="/examenes/<%= examen.id_examenes %>/eliminar" method="POST"
                          style="display:inline;">
                          <button type="submit" onclick="return confirm('Eliminar examen?')">Eliminar</button>
                        </form>
                        <% } %>

                </div>
              </td>
            </tr>
            <% }); %>
        </tbody>
      </table>

      <hr>

      <section id="agregar-examen">
        <% if (esBioanalista || esSecretaria) { %>
          <h2>
            <%= examenEditar ? 'Editar Examen' : 'Agregar Nuevo Examen' %>
          </h2>
          <form
            action="<%= examenEditar ? '/examenes/' + examenEditar.id_examenes + '/actualizar' : '/examenes/nuevo' %>"
            method="POST">
            <label for="nombre">Nombre (opcional, se auto-genera):</label>
            <input type="text" id="nombre" name="nombre" value="<%= examenEditar ? examenEditar.nombre_examenes : '' %>"
              placeholder="Ej: Hematologia Completa">

            <label for="precio">Precio ($):</label>
            <input type="number" id="precio" name="precio"
              value="<%= examenEditar ? examenEditar.precio_examenes : '' %>" required>

            <button type="submit">
              <%= examenEditar ? 'Guardar Cambios' : 'Agregar Examen' %>
            </button>
            <% if (examenEditar) { %>
              <a href="/examenes"><button type="button">Cancelar</button></a>
              <% } %>
          </form>
          <% } %>
      </section>

      <div id="modal-formulario" class="modal-overlay">
        <div class="modal-box">
          <h3>Que tipo de analisis deseas registrar?</h3>
          <a href="/analisis/hematologia" class="btn-tipo">Hematologia Completa</a>
          <a href="/analisis/perfil_renal" class="btn-tipo">Perfil Renal</a>
          <a href="/analisis/perfil_lipidico" class="btn-tipo">Perfil Lipidico</a>
          <button class="btn-tipo btn-cancelar" onclick="cerrarModal()">Cancelar</button>
        </div>
      </div>

      <script>
        function abrirModal(idExamen) {
          var eid = idExamen ? '?eid=' + idExamen : '';
          document.querySelector('[href*="hematologia"]').href = '/analisis/hematologia' + eid;
          document.querySelector('[href*="perfil_renal"]').href = '/analisis/perfil_renal' + eid;
          document.querySelector('[href*="perfil_lipidico"]').href = '/analisis/perfil_lipidico' + eid;
          document.getElementById('modal-formulario').classList.add('active');
        }
        function cerrarModal() {
          document.getElementById('modal-formulario').classList.remove('active');
        }
        document.getElementById('modal-formulario').addEventListener('click', function (e) {
          if (e.target === this) cerrarModal();
        });
      </script>

</body>

</html>