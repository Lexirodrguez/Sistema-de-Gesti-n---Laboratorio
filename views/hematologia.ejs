<!DOCTYPE html>
<html lang="es">

<head>
  <title>Hematologia Completa</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>
  <div class="logout-container">
    <a href="/auth/logout" class="logout-btn">Cerrar Sesion</a>
  </div>

  <h1>Resultados: Hematologia Completa</h1>
  <nav>
    <ul>
      <li><a href="/">Inicio</a></li>
      <li><a href="/examenes">Volver a Examenes</a></li>
    </ul>
  </nav>

  <section>
    <h2>Datos del Resultado</h2>
    <form action="/analisis/guardar-hematologia" method="POST">

      <label for="examenId">Examen asociado:</label>
      <select name="examenId" id="examenId" required>
        <% examenes.forEach(function(e) { %>
          <option value="<%= e.id_examenes %>" <%=e.id_examenes==selectedEid ? 'selected' : '' %>>
            <%= e.nombre_examenes %>
          </option>
          <% }); %>
      </select>

      <label for="pacienteId">Seleccionar Paciente:</label>
      <select name="pacienteId" id="pacienteId" required>
        <% pacientes.forEach(function(p) { %>
          <option value="<%= p.id_pacientes %>">
            <%= p.nombre_pacientes %>
          </option>
          <% }); %>
      </select>

      <label for="Recuento_globulos_blancos">Globulos Blancos (K/uL):</label>
      <input type="number" id="Recuento_globulos_blancos" name="Recuento_globulos_blancos" placeholder="Ej: 4500"
        required>

      <label for="Hemoglobina">Hemoglobina (g/dL):</label>
      <input type="number" step="0.01" id="Hemoglobina" name="Hemoglobina" placeholder="Ej: 14.5" required>

      <label for="Hematocrito">Hematocrito (%):</label>
      <input type="number" step="0.01" id="Hematocrito" name="Hematocrito" placeholder="Ej: 42" required>

      <label for="Recuento_plaquetas">Plaquetas (K/uL):</label>
      <input type="number" id="Recuento_plaquetas" name="Recuento_plaquetas" placeholder="Ej: 150000" required>

      <button type="submit">Guardar Resultado</button>
      <a href="/examenes"><button type="button">Cancelar</button></a>
    </form>
  </section>
</body>

</html>