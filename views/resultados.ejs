<!DOCTYPE html>
<html>

<head>
  <title>Gestión de Resultados</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>
  <div class="logout-container">
    <a href="/auth/logout" class="logout-btn">Cerrar Sesión</a>
  </div>

  <h1>Lista de Resultados Registrados</h1>
  <nav>
    <ul>
      <li><a href="/">Inicio</a></li>
      <li><a href="/examenes">Registrar Nuevo</a></li>
    </ul>
  </nav>


  <section>
    <table>
      <thead>
        <tr>
          <th>ID</th>
          <th>Paciente</th>
          <th>Examen</th>
          <th>Fecha</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% resultados.forEach(res=> { %>
          <tr>
            <td>
              <%= res.id_resultados %>
            </td>
            <td>
              <%= res.nombre_pacientes %>
            </td>
            <td>
              <%= res.nombre_examenes %>
            </td>
            <td>
              <%= new Date(res.fecha_resultados).toLocaleDateString() %>
            </td>
            <td>
              <form action="/resultados/<%= res.id_resultados %>/eliminar" method="POST" style="display:inline;">
                <button type="submit" class="btn-eliminar" onclick="return confirm('¿Eliminar?')">Eliminar</button>
              </form>
            </td>
          </tr>
          <% }) %>
      </tbody>
    </table>
  </section>
</body>

</html>