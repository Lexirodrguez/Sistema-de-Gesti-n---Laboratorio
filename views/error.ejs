<!DOCTYPE html>
<html>

<head>
    <title>Error - Laboratorio</title>
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>

<body
    style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100vh; margin: 0; background-color: #f7f9fc;">
    <div
        style="background: white; padding: 40px; border-radius: 16px; box-shadow: 0 10px 30px rgba(0,0,0,0.1); text-align: center; max-width: 500px; border: 1px solid #eee;">
        <h1 style="color: #d93025; font-size: 48px; margin-bottom: 10px;">¡Ups!</h1>
        <h2 style="color: #333; margin-bottom: 20px;">
            <%= message %>
        </h2>
        <p style="color: #666; margin-bottom: 30px;">Parece que no tienes los permisos necesarios para estar aquí.</p>
        <a href="/" class="btn"
            style="background-color: #1a73e8; padding: 12px 30px; border-radius: 8px; text-decoration: none; color: white; font-weight: bold;">Volver
            al Inicio</a>
        <% if (locals.error && error.stack) { %>
            <pre
                style="text-align: left; background: #fafafa; padding: 15px; margin-top: 30px; font-size: 11px; overflow-x: auto; max-height: 150px; color: #888; border-radius: 8px;"><%= error.stack %></pre>
            <% } %>
    </div>
</body>

</html>