<!DOCTYPE html>
<html lang="es">

<head>
  <title>Perfil Renal</title>
  <link rel="stylesheet" href="/stylesheets/style.css" />
</head>

<body>
  <div class="logout-container">
    <a href="/auth/logout" class="logout-btn">Cerrar Sesion</a>
  </div>

  <h1>Resultados: Perfil Renal</h1>
  <nav>
    <ul>
      <li><a href="/">Inicio</a></li>
      <li><a href="/examenes">Volver a Examenes</a></li>
    </ul>
  </nav>

  <section>
    <h2>Datos del Resultado</h2>
    <form action="/analisis/guardar-perfilrenal" method="POST">

      <label for="examenId">Examen asociado:</label>
      <select name="examenId" id="examenId" required>
        <% examenes.forEach(function(e) { %>
          <option value="<%= e.id_examenes %>" <%=e.id_examenes==selectedEid ? 'selected' : '' %>>
            <%= e.nombre_examenes %>
          </option>
          <% }); %>
      </select>

      <label for="pacienteId">Seleccionar Paciente:</label>
      <select name="pacienteId" id="pacienteId" required>
        <% pacientes.forEach(function(p) { %>
          <option value="<%= p.id_pacientes %>">
            <%= p.nombre_pacientes %>
          </option>
          <% }); %>
      </select>

      <label for="albumina_orina">Albumina en Orina (mg/dL):</label>
      <input type="number" step="0.01" id="albumina_orina" name="albumina_orina" placeholder="Ej: 20.5">

      <label for="bun">BUN (mg/dL):</label>
      <input type="number" step="0.01" id="bun" name="bun" placeholder="Ej: 15.2" required>

      <label for="relacion_bun_creatinina">Relacion BUN/Creatinina:</label>
      <input type="number" step="0.01" id="relacion_bun_creatinina" name="relacion_bun_creatinina"
        placeholder="Ej: 10.5">

      <label for="calcio">Calcio (mg/dL):</label>
      <input type="number" step="0.01" id="calcio" name="calcio" placeholder="Ej: 9.2">

      <label for="dioxido_carbono">Dioxido de Carbono (mEq/L):</label>
      <input type="number" step="0.01" id="dioxido_carbono" name="dioxido_carbono" placeholder="Ej: 24.0">

      <label for="cloruro">Cloruro (mEq/L):</label>
      <input type="number" step="0.01" id="cloruro" name="cloruro" placeholder="Ej: 102.0">

      <label for="cociente_urea_creatinina">Cociente Urea/Creatinina:</label>
      <input type="number" step="0.01" id="cociente_urea_creatinina" name="cociente_urea_creatinina"
        placeholder="Ej: 30.0">

      <label for="tasa_filtrado_glomerular_tefg">Tasa Filtrado Glomerular (eFG):</label>
      <input type="number" id="tasa_filtrado_glomerular_tefg" name="tasa_filtrado_glomerular_tefg" placeholder="Ej: 90">

      <label for="anion_gap">Anion Gap:</label>
      <input type="number" step="0.01" id="anion_gap" name="anion_gap" placeholder="Ej: 12.5">

      <button type="submit">Guardar Resultado</button>
      <a href="/examenes"><button type="button">Cancelar</button></a>
    </form>
  </section>
</body>

</html>